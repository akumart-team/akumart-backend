model Dispute {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @unique @map("order_id") @db.Uuid
  openedById     String            @map("opened_by_id") @db.Uuid
  reason         String
  status         DisputeStatus     @default(open)
  decision       DisputeDecision?
  decisionReason String?           @map("decision_reason")
  refundAmount   Decimal?          @map("refund_amount") @db.Decimal(20, 2)
  resolvedById   String?           @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  order          Order             @relation(fields: [orderId, openedById], references: [id, buyerId], onDelete: Restrict, onUpdate: Restrict)
  opener         Profile           @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  resolver       Profile?          @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  evidence       DisputeEvidence[]
  tickets        SupportTicket[]
  refunds        Refund[]

  @@unique([orderId, openedById])
  @@index([status, createdAt])
  @@index([openedById])
  @@index([resolvedById])
  @@map("disputes")
}

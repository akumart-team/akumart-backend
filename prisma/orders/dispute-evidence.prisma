model DisputeEvidence {
  id          String   @id @default(uuid()) @db.Uuid
  disputeId   String   @map("dispute_id") @db.Uuid
  uploadId    String?  @map("upload_id") @db.Uuid
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  upload      Upload?  @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@index([uploadId])
  @@map("dispute_evidence")
}

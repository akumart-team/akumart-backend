model BinMaintenanceTicket {
  id           String            @id @default(uuid()) @db.Uuid
  binId        String            @map("bin_id") @db.Uuid
  issue        String
  status       MaintenanceStatus @default(open)
  openedById   String            @map("opened_by_id") @db.Uuid
  resolvedById String?           @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  bin          Bin               @relation(fields: [binId], references: [id], onDelete: Restrict)

  @@index([binId, status])
  @@map("bin_maintenance_tickets")
}

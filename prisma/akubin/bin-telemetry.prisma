model BinTelemetry {
  id             String    @id @default(uuid()) @db.Uuid
  binId          String    @map("bin_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  distanceCm     Decimal   @map("distance_cm") @db.Decimal(10, 3)
  reportedFull   Boolean   @map("reported_full")
  // Firmware timestamp is millis() since boot, not a Unix timestamp.
  deviceUptimeMs BigInt    @map("device_uptime_ms")
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  bin            Bin       @relation(fields: [binId], references: [id], onDelete: Restrict)
  device         BinDevice @relation(fields: [deviceId, binId], references: [id, binId], onDelete: Restrict, onUpdate: Restrict)

  @@index([binId, receivedAt])
  @@index([deviceId, receivedAt])
  @@map("bin_telemetry")
}

model OfferStep {
  id         String      @id @default(uuid()) @db.Uuid
  offerId    String      @map("offer_id") @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  sequence   Int
  action     OfferAction
  unitPrice  Decimal     @map("unit_price") @db.Decimal(20, 2)
  quantity   Decimal     @db.Decimal(18, 3)
  conditions String[]    @default([])
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  offer      Offer       @relation(fields: [offerId], references: [id], onDelete: Restrict)
  actor      Profile?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([offerId, sequence])
  @@index([actorId])
  @@map("offer_steps")
}

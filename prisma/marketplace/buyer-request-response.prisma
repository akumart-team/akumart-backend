model BuyerRequestResponse {
  id        String                @id @default(uuid()) @db.Uuid
  requestId String                @map("request_id") @db.Uuid
  sellerId  String                @map("seller_id") @db.Uuid
  unitPrice Decimal               @map("unit_price") @db.Decimal(20, 2)
  quantity  Decimal               @db.Decimal(18, 3)
  note      String?
  status    RequestResponseStatus @default(sent)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  request   BuyerRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  seller    Profile               @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([requestId, sellerId])
  @@index([sellerId])
  @@map("buyer_request_responses")
}

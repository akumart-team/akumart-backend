model ListingReport {
  id         String    @id @default(uuid()) @db.Uuid
  listingId  String    @map("listing_id") @db.Uuid
  reporterId String    @map("reporter_id") @db.Uuid
  reason     String
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  reporter   Profile   @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([listingId, resolvedAt])
  @@index([reporterId])
  @@map("listing_reports")
}

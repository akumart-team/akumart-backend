model Listing {
  id               String            @id @default(uuid()) @db.Uuid
  sellerId         String            @map("seller_id") @db.Uuid
  title            String            @db.VarChar(200)
  material         Material
  grade            String            @db.VarChar(100)
  condition        MaterialCondition
  quantity         Decimal           @db.Decimal(18, 3)
  // Total stock; available = quantity - reservedQuantity - soldQuantity.
  reservedQuantity Decimal           @default(0) @map("reserved_quantity") @db.Decimal(18, 3)
  soldQuantity     Decimal           @default(0) @map("sold_quantity") @db.Decimal(18, 3)
  unit             QuantityUnit
  unitPrice        Decimal           @map("unit_price") @db.Decimal(20, 2)
  currency         String            @default("NGN") @db.Char(3)
  minOrder         Decimal           @map("min_order") @db.Decimal(18, 3)
  allowPartial     Boolean           @default(false) @map("allow_partial")
  city             String            @db.VarChar(100)
  area             String            @db.VarChar(200)
  description      String
  status           ListingStatus     @default(draft)
  views            Int               @default(0)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  seller           Profile           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  images           ListingImage[]
  savedBy          SavedListing[]
  reports          ListingReport[]
  offers           Offer[]
  orders           Order[]

  @@unique([id, sellerId])
  @@index([status, material, city, createdAt])
  @@index([sellerId, status])
  @@map("listings")
}

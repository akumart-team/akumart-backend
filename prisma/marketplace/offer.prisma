model Offer {
  id        String      @id @default(uuid()) @db.Uuid
  listingId String      @map("listing_id") @db.Uuid
  buyerId   String      @map("buyer_id") @db.Uuid
  sellerId  String      @map("seller_id") @db.Uuid
  status    OfferStatus @default(awaiting_seller)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  version   Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  listing   Listing     @relation(fields: [listingId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  buyer     Profile     @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  steps     OfferStep[]
  order     Order?

  @@unique([id, listingId, buyerId, sellerId])
  @@index([buyerId, status])
  @@index([listingId, status])
  @@index([status, expiresAt])
  @@map("offers")
}

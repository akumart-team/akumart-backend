model PartnerDocument {
  partnerId String  @map("partner_id") @db.Uuid
  uploadId  String  @map("upload_id") @db.Uuid
  kind      String  @db.VarChar(80)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  upload    Upload  @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@id([partnerId, uploadId])
  @@index([uploadId])
  @@map("partner_documents")
}

model Enquiry {
  id        String      @id @default(uuid()) @db.Uuid
  kind      EnquiryKind
  name      String
  email     String
  data      Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([kind, createdAt])
  @@map("enquiries")
}

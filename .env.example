NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Use your intended development/staging database. Never commit real credentials.
DATABASE_URL=postgresql://postgres:password@localhost:5432/akumart
DIRECT_URL=postgresql://postgres:password@localhost:5432/akumart
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key

# Optional one-time staff bootstrap: UUID of the intended email-verified first super.
# POST /api/v1/admin/staff/bootstrap authenticates this account and works only before any super exists.
# Leave empty normally; remove after bootstrap. Subsequent changes use super-only staff endpoints.
STAFF_BOOTSTRAP_PROFILE_ID=

# Required for PIN setup and hardware session identification; keep stable and server-only.
AKUBIN_PIN_LOOKUP_SECRET=
# Explicitly enable only when using the current bin-ID-only firmware.
AKUBIN_ALLOW_LEGACY_HARDWARE=false
AKUBIN_SESSION_TTL_SECONDS=300
AKUBIN_MAX_DEPOSIT_GRAMS=100000

# Private Supabase Storage bucket; never use a public bucket for identity documents.
UPLOADS_BUCKET=akumart-private

# Paystack test keys for development. Configure the webhook URL as /api/v1/webhooks/paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=http://localhost:5173/app/payments/callback
# Enable after configuring your Paystack balance and transfer approval policy.
PAYSTACK_TRANSFERS_ENABLED=false

# Random stable secret of at least 32 characters, used to sign advertising event tokens.
CAMPAIGN_TRACKING_SECRET=

# Stateless AI support relay. No conversations are stored by this backend.
ASSISTANT_API_URL=https://akubin-ai-classifier.vercel.app/api/v1/ai/support/messages
# Optional server-only bearer key if the AI service requires authentication.
ASSISTANT_API_KEY=
